generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Dernière synchronisation manuelle vers Google Calendar.
  lastSyncedAt  DateTime?
  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  tasks         Task[]
  habits        Habit[]
  habitLogs     HabitLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  color       String    @default("#6366f1")
  targetDate  DateTime?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  habits      Habit[]

  @@index([userId])
}

model Task {
  id            String    @id @default(cuid())
  userId        String
  goalId        String?
  title         String
  done          Boolean   @default(false)
  dueDate       DateTime?
  googleEventId String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([goalId])
  @@index([userId, dueDate])
}

/**
 * Discipline récurrente liée à un objectif long terme.
 * DAILY  = case du jour (ex. pas d'alcool)
 * WEEKLY = quota de la semaine (ex. 3 joggings, 10 repas légers)
 */
model Habit {
  id        String    @id @default(cuid())
  userId    String
  goalId    String?
  title     String
  kind      HabitKind @default(DAILY)
  /// Cible : 1 pour le quotidien ; N pour le quota hebdo.
  target    Int       @default(1)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  logs      HabitLog[]

  @@index([userId])
  @@index([goalId])
}

model HabitLog {
  id         String   @id @default(cuid())
  habitId    String
  userId     String
  /// Jour UTC où l'occurrence a eu lieu (minuit).
  occurredOn DateTime
  createdAt  DateTime @default(now())
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([habitId, occurredOn])
  @@index([userId, occurredOn])
}

enum HabitKind {
  DAILY
  WEEKLY
}
