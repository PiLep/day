# Base de données (SQLite en dev, remplacer par Postgres en prod)
DATABASE_URL="file:./dev.db"

# Auth.js — générer avec : npx auth secret
AUTH_SECRET="change-me"

# OAuth Google (https://console.cloud.google.com/apis/credentials)
# Activer l'API "Google Calendar API" et créer un client OAuth 2.0
# URI de redirection : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# URL publique de l'app (prod)
# AUTH_URL="https://day.example.com"
