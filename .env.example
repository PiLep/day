# Base de données PostgreSQL
# En dev : instance locale, Docker (docker run -d -p 5432:5432 \
#   -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=day postgres:16)
# ou une branche de dev Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/day"

# Auth.js — générer avec : npx auth secret
AUTH_SECRET="change-me"

# OAuth Google (https://console.cloud.google.com/apis/credentials)
# Activer l'API "Google Calendar API" et créer un client OAuth 2.0
# URI de redirection : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# URL publique de l'app (prod)
# AUTH_URL="https://day.example.com"

# Optionnel — enrichit les réponses du coach (sinon heuristiques FR offline)
# OPENAI_API_KEY="sk-..."
